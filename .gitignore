.env
.env.local

# Lightroom workspace (catalog files + local reference photos, not for git)
photography/_lightroom/

# Raw photo drops (kept local + on Dropbox; 2-edited/ exports are tracked for re-processing)
photography/*/1-original/

# Video source frames (large, regenerable from MP4)
video/

# Local working / scratch
bug/

# Share / handoff assets (large binaries, kept local + on Dropbox, never for git)
share/

# Social + photography working media. The heavy image/video binaries are kept
# local + on Dropbox; only the web-optimised copies under website/main/public/
# are tracked. Caption copy (_post.txt), scripts, schedule, manifest, and fonts
# stay in git.
social/**/*.jpg
social/**/*.jpeg
social/**/*.JPG
social/**/*.png
social/**/*.PNG
social/**/*.mp4
social/**/*.MP4
social/**/*.mov
social/**/*.MOV
social/**/*.gif
social/**/*.webp
social/**/*.psd
social/**/*.tif
social/**/*.tiff
social/**/*.heic
social/**/*.HEIC
