# Lightroom workspace (catalog files + local reference photos, not for git)
photography/_lightroom/

# Raw photo drops (kept local + on Dropbox; 2-edited/ exports are tracked for re-processing)
photography/*/1-original/

# Video source frames (large, regenerable from MP4)
video/

# Local working / scratch
bug/

# Share / handoff assets (large binaries, kept local + on Dropbox, never for git)
share/

# Instagram post content (images, video, captions, scripts, fonts) no longer
# lives in this repo. It is the shared Dropbox `social` folder — the single
# source of truth across Tom's and Rieko's Macs. The internal /instagram
# dashboard reads it via AUWA_SOCIAL_ROOT (see src/lib/social-root.ts). Only
# the web-optimised copies under website/main/public/ are tracked here.

# Photography working media. Heavy binaries kept local + on Dropbox.
photography/**/*.jpg
photography/**/*.jpeg
photography/**/*.JPG
photography/**/*.png
photography/**/*.PNG
photography/**/*.mp4
photography/**/*.MP4
photography/**/*.mov
photography/**/*.MOV
photography/**/*.gif
photography/**/*.webp
photography/**/*.psd
